	partition fact_order_lines = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "fact_order_lines.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"order_item_id", Int64.Type}, {"order_id", Int64.Type}, {"order_date", type date}, {"customer_id", Int64.Type}, {"product_id", Int64.Type}, {"country_code", type text}, {"device", type text}, {"payment_method", type text}, {"order_status", type text}, {"is_first_order", type logical}, {"quantity", Int64.Type}, {"unit_price", type number}, {"gross_amount", type number}, {"discount_amount", type number}, {"line_revenue", type number}, {"line_cogs", type number}})
				in
				    Typed

