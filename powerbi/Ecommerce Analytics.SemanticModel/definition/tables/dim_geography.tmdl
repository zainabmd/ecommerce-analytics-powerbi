	partition dim_geography = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "dim_geography.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"country_code", type text}, {"country", type text}, {"region", type text}, {"currency", type text}, {"price_index", type number}})
				in
				    Typed

