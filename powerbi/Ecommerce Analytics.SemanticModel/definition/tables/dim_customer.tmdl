table dim_customer
	lineageTag: 359e3a84-937f-515b-9004-b801ea3e6cce

	measure Customers = COUNTROWS(dim_customer)
		formatString: #,0
		displayFolder: Segmentation
		lineageTag: 09d66ad8-b3fe-5451-95ef-6169c05d0309

	measure 'Avg Historical CLV' = AVERAGE(dim_customer[historical_clv])
		formatString: $#,0
		displayFolder: Segmentation
		lineageTag: c9dc1a32-8a77-5d39-b883-5f376678c50e

	measure 'Predicted CLV 12m' = SUM(dim_customer[predicted_clv_12m])
		formatString: $#,0
		displayFolder: Segmentation
		lineageTag: 98637d82-5bfd-5105-a35c-a84c6458c4bb

	measure 'Avg Recency (days)' = AVERAGE(dim_customer[recency_days])
		formatString: #,0
		displayFolder: Segmentation
		lineageTag: 63fb21f5-5046-5737-acb5-17c07fb34e74

	measure 'Avg Spend' = AVERAGE(dim_customer[monetary])
		formatString: $#,0
		displayFolder: Segmentation
		lineageTag: f2652ada-ba3d-59d6-add1-e0f6f9004e06

	measure 'Customer Share' = DIVIDE([Customers], CALCULATE([Customers], REMOVEFILTERS(dim_customer[persona])))
		formatString: 0.0%
		displayFolder: Segmentation
		lineageTag: 40cd260b-c9c9-530f-b6fa-33b66a8ad959

